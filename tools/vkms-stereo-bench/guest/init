#!/bin/busybox sh
# SPDX-License-Identifier: GPL-2.0-or-later
# PID 1 of the vkms-stereo-bench guest. Mounts the pseudo file systems and runs the phase named by
# bench.phase= on the kernel command line. Results go to the serial console as STEREO| lines.
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config 2>/dev/null
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
exec 0</dev/console 1>/dev/console 2>&1
phase=none
for a in $(cat /proc/cmdline); do
    case "$a" in bench.phase=*) phase=${a#bench.phase=} ;; esac
done
echo "STEREO|phase|$phase"
mkdir -p /out
mount -t 9p -o trans=virtio,version=9p2000.L out /out 2>/dev/null || echo "STEREO|info|out|no output share"
if [ -f "/phases/$phase.sh" ]; then
    . "/phases/$phase.sh"
else
    echo "STEREO|check|phase|FAIL|no such phase: $phase"
fi
echo "STEREO|done|$phase"
sync
umount /out 2>/dev/null
poweroff -f
sleep 5
echo o > /proc/sysrq-trigger 2>/dev/null
