# On top of x86_64_defconfig: a kernel that also runs a desktop compositor from a 9p root (the kwin phase).
CONFIG_DRM=y
CONFIG_DRM_VKMS=y
CONFIG_SYNC_FILE=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_KUNIT=y
CONFIG_DRM_VKMS_KUNIT_TEST=y
